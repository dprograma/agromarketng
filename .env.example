# ─── App ────────────────────────────────────────────────────────────────
APP_PORT=3000
APP_URL=http://localhost:3000
APP_SECRET=your_super_secret_jwt_key_change_this

# ─── Groq AI ─────────────────────────────────────────────────────────────
# Free tier: 14,400 req/day, 30 RPM — no billing required
# Get key at: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key
# Model options (all free):
#   llama-3.3-70b-versatile ← default, best quality
#   llama-3.1-8b-instant    ← fastest, lighter
#   mixtral-8x7b-32768      ← good balance
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Image Source (Unsplash) ─────────────────────────────────────────────
# Get free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
# Fallback: Pexels (https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key

# ─── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
APPROVAL_EMAIL=your_approval_email@example.com
EMAIL_FROM="AgroMarket Social <your_email@gmail.com>"

# ─── Facebook / Instagram ────────────────────────────────────────────────
# OAuth connect — use the Connect button in Settings (recommended, never expires)
# Get these from: developers.facebook.com → your app → Settings → Basic
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret
# Legacy manual fallback (only needed if not using the Connect button)
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ─── Twitter / X ─────────────────────────────────────────────────────────
# https://developer.twitter.com → Project & App → Keys & Tokens
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# ─── LinkedIn ─────────────────────────────────────────────────────────────
# OAuth connect — use the Connect button in Settings (recommended, auto-renews)
# Get these from: linkedin.com/developers → your app → Auth tab
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Legacy manual fallback (only needed if not using the Connect button)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:your_person_id

# ─── TikTok ───────────────────────────────────────────────────────────────
# https://developers.tiktok.com → Login Kit / Content Posting API
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# ─── Website Concept ──────────────────────────────────────────────────────
# Brief description of your website (used by Gemini to generate relevant posts)
SITE_NAME=AgroMarket
SITE_CONCEPT=A classified marketplace platform connecting farmers, agro dealers, buyers and sellers of agricultural products, farm equipment, livestock, seeds, fertilizers and agro services across Nigeria and West Africa. Users can post free classified ads and browse listings for fresh produce, grains, poultry, cattle, tractors, irrigation systems and more.
SITE_URL=https://agromarketng.com
